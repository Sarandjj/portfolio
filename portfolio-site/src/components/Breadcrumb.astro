---
/** `ta` is the Tamil label, swapped in when the visitor picks தமிழ் */
interface Props { items: { label: string; href?: string; ta?: string }[] }
const { items } = Astro.props;
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {
      items.map((it, i) => (
        <li>
          {it.href && i < items.length - 1 ? <a href={it.href} data-ta={it.ta}>{it.label}</a> : <span aria-current="page" data-ta={it.ta}>{it.label}</span>}
        </li>
      ))
    }
  </ol>
</nav>
