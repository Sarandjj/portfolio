---
// A colour kolam at the doorstep with agal vilakku (clay oil lamps) around it, as for Karthigai Deepam.
// When it scrolls into view the kolam draws itself, the colours fill in, and the lamps light one by one.
// Each lamp can be tapped to light or put out (src/scripts/home.ts).
const LAMPS = [
  [26, 168], [78, 146], [128, 170], [392, 170], [442, 146], [494, 168],
];
// 5 x 5 pulli (dot) grid at the centre
const DOTS = Array.from({ length: 25 }, (_, i) => [212 + (i % 5) * 24, 56 + Math.floor(i / 5) * 24]);
const PETALS = [0, 45, 90, 135, 180, 225, 270, 315];
---

<div class="doorstep reveal">
  <svg viewBox="0 0 520 210" aria-hidden="true">
    <defs>
      <radialGradient id="clay" cx="0.5" cy="0.2" r="0.9">
        <stop offset="0" stop-color="#d9773f"></stop>
        <stop offset="0.6" stop-color="#a8461c"></stop>
        <stop offset="1" stop-color="#6e2a0e"></stop>
      </radialGradient>
      <radialGradient id="flame" cx="0.5" cy="0.75" r="0.7">
        <stop offset="0" stop-color="#fffde7"></stop>
        <stop offset="0.35" stop-color="#ffe082"></stop>
        <stop offset="0.75" stop-color="#ffa000"></stop>
        <stop offset="1" stop-color="#e65100" stop-opacity="0.2"></stop>
      </radialGradient>
      <radialGradient id="halo" cx="0.5" cy="0.5" r="0.5">
        <stop offset="0" stop-color="#ffc107" stop-opacity="0.55"></stop>
        <stop offset="1" stop-color="#ffc107" stop-opacity="0"></stop>
      </radialGradient>
      <linearGradient id="oxide" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#a5463a"></stop>
        <stop offset="1" stop-color="#7c2f24"></stop>
      </linearGradient>
    </defs>

    <!-- red oxide doorstep floor, polished, with a soft sheen -->
    <rect x="4" y="6" width="512" height="200" rx="26" fill="url(#oxide)" class="floor" />
    <rect x="4" y="6" width="512" height="200" rx="26" fill="none" class="floor-edge" />
    <path d="M30 22 H490" class="floor-sheen" />

    <!-- coloured fill (rangoli powder), drawn after the lines -->
    <g class="kc">
      {PETALS.map((a, i) => (
        <g transform={`rotate(${a} 260 104)`}>
          <path d="M260 104 Q280 70 260 40 Q240 70 260 104Z" class={i % 2 ? 'p2' : 'p1'} style={`--i:${i}`} />
        </g>
      ))}
      <circle cx="260" cy="104" r="20" class="p3" />
      <circle cx="260" cy="104" r="9" class="p4" />
    </g>
    <!-- white rice-flour lines around the dots -->
    <g class="kl">
      <path d="M260 22 C318 22 342 46 342 104 C342 162 318 186 260 186 C202 186 178 162 178 104 C178 46 202 22 260 22Z" />
      <path d="M260 40 Q300 52 316 104 Q300 156 260 168 Q220 156 204 104 Q220 52 260 40Z" />
      <path d="M212 56 Q236 80 212 104 Q236 128 212 152 M308 56 Q284 80 308 104 Q284 128 308 152 M212 56 Q260 80 308 56 M212 152 Q260 128 308 152" />
    </g>
    {DOTS.map(([x, y]) => <circle cx={x} cy={y} r="1.9" class="pulli" />)}

    {
      LAMPS.map(([x, y], i) => (
        <g class="lamp on" transform={`translate(${x} ${y})`} style={`--i:${i}`} data-lamp>
          <ellipse cx="0" cy="8" rx="20" ry="4" class="ground" />
          <circle cx="0" cy="-16" r="22" fill="url(#halo)" class="halo" />
          <path class="flame" d="M0 -30 C6 -20 6 -12 0 -6 C-6 -12 -6 -20 0 -30Z" fill="url(#flame)" />
          <path d="M0 -6 V-1" stroke="#3e2723" stroke-width="1.4" />
          <path d="M-17 -4 Q0 -1 17 -4 Q13 11 0 12 Q-13 11 -17 -4Z" fill="url(#clay)" />
          <path d="M-17 -4 Q0 2 17 -4" fill="none" stroke="#4e1f0a" stroke-width="1.2" />
          <path d="M-17 -4 Q0 -7 17 -4" fill="none" stroke="#f0a070" stroke-width="0.8" opacity=".7" />
          <rect x="-22" y="-36" width="44" height="52" fill="transparent" class="hit" />
        </g>
      ))
    }
  </svg>
  <p class="doorstep-hint" data-ta="விளக்கைத் தொட்டு ஏற்றுங்கள் 🪔">Tap a lamp to light it 🪔</p>
</div>
