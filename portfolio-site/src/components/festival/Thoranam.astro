---
// Maavilai thoranam: mango leaves folded over a twisted rope, with strings of marigolds between them.
// Leaves are shaded (light edge, dark edge, midrib and veins) so they read as real leaves, each sways on
// its own, and the ones near the pointer flick as it passes (src/scripts/home.ts).
const W = 1400;
const sag = (x: number) => {
  const t = x / W;
  return (1 - t) * (1 - t) * 8 + 2 * (1 - t) * t * 72 + t * t * 8;
};
const items = Array.from({ length: Math.floor(W / 28) }, (_, i) => {
  const x = 14 + i * 28;
  const kind = i % 5 === 2 ? 'flower' : 'leaf';
  return {
    x,
    y: sag(x),
    kind,
    len: 54 + ((i * 7) % 4) * 5,
    tilt: ((i * 13) % 9) - 4,
    tone: i % 3 === 0 ? 'b' : 'a',
    flip: i % 2 ? -1 : 1,
    delay: -((i * 0.41) % 3.4).toFixed(2),
    yellow: i % 10 === 7,
  };
});
const leaf = (L: number) => {
  const w = L * 0.24;
  return {
    body: `M0 0 C${w * 0.95} ${L * 0.18} ${w * 1.15} ${L * 0.6} ${w * 0.18} ${L} C${-w * 0.85} ${L * 0.74} ${-w * 1.05} ${L * 0.26} 0 0Z`,
    rib: `M0 3 Q${w * 0.28} ${L * 0.5} ${w * 0.16} ${L - 4}`,
    veins: [0.24, 0.38, 0.52, 0.66, 0.8]
      .map((t) => {
        const mx = w * 0.28 * Math.sin(Math.PI * t) * 0.9;
        const y = L * t;
        return `M${mx} ${y} L${w * 0.72} ${y + L * 0.09} M${mx} ${y} L${-w * 0.62} ${y + L * 0.09}`;
      })
      .join(' '),
    shine: `M${w * 0.55} ${L * 0.22} C${w * 0.8} ${L * 0.45} ${w * 0.7} ${L * 0.7} ${w * 0.3} ${L * 0.9}`,
  };
};
const PETALS_OUT = Array.from({ length: 18 }, (_, i) => i * 20);
const PETALS_IN = Array.from({ length: 12 }, (_, i) => i * 30 + 15);
---

<div class="thoranam" aria-hidden="true">
  <svg viewBox={`0 0 ${W} 110`} preserveAspectRatio="xMidYMin slice">
    <defs>
      <linearGradient id="leaf-a" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#1b5e20"></stop>
        <stop offset="0.45" stop-color="#3f9142"></stop>
        <stop offset="0.7" stop-color="#5cad4f"></stop>
        <stop offset="1" stop-color="#2e7d32"></stop>
      </linearGradient>
      <linearGradient id="leaf-b" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#33691e"></stop>
        <stop offset="0.5" stop-color="#689f38"></stop>
        <stop offset="1" stop-color="#3b6e1f"></stop>
      </linearGradient>
      <radialGradient id="mari-o" cx="0.5" cy="0.45" r="0.6">
        <stop offset="0" stop-color="#ffd54f"></stop>
        <stop offset="0.55" stop-color="#ffa000"></stop>
        <stop offset="1" stop-color="#e65100"></stop>
      </radialGradient>
      <radialGradient id="mari-y" cx="0.5" cy="0.45" r="0.6">
        <stop offset="0" stop-color="#fff59d"></stop>
        <stop offset="0.55" stop-color="#fdd835"></stop>
        <stop offset="1" stop-color="#f9a825"></stop>
      </radialGradient>
      <symbol id="marigold-o" viewBox="-12 -12 24 24" overflow="visible">
        {PETALS_OUT.map((a) => <ellipse cx="0" cy="-7" rx="3.4" ry="5.2" transform={`rotate(${a})`} fill="url(#mari-o)" stroke="#bf360c" stroke-width="0.4" />)}
        {PETALS_IN.map((a) => <ellipse cx="0" cy="-3.6" rx="2.6" ry="4" transform={`rotate(${a})`} fill="url(#mari-o)" stroke="#e65100" stroke-width="0.3" />)}
        <circle r="2.4" fill="#e65100"></circle>
      </symbol>
      <symbol id="marigold-y" viewBox="-12 -12 24 24" overflow="visible">
        {PETALS_OUT.map((a) => <ellipse cx="0" cy="-7" rx="3.4" ry="5.2" transform={`rotate(${a})`} fill="url(#mari-y)" stroke="#f57f17" stroke-width="0.4" />)}
        {PETALS_IN.map((a) => <ellipse cx="0" cy="-3.6" rx="2.6" ry="4" transform={`rotate(${a})`} fill="url(#mari-y)" stroke="#f9a825" stroke-width="0.3" />)}
        <circle r="2.4" fill="#f57f17"></circle>
      </symbol>
    </defs>

    <!-- twisted cotton rope: a dark core with light twists along it -->
    <path d={`M0 8 Q${W / 2} 72 ${W} 8`} class="rope" />
    <path d={`M0 8 Q${W / 2} 72 ${W} 8`} class="rope-twist" />

    {
      items.map((it) => {
        if (it.kind === 'flower') {
          const id = it.yellow ? '#marigold-y' : '#marigold-o';
          return (
            <g class="sway" style={`transform-origin:${it.x}px ${it.y}px;animation-delay:${it.delay}s`} data-x={it.x}>
              <g class="push">
                <path d={`M${it.x} ${it.y} V${it.y + 62}`} class="string" />
                <use href={id} x={it.x - 11} y={it.y + 10} width="22" height="22" />
                <use href={it.yellow ? '#marigold-o' : '#marigold-y'} x={it.x - 10} y={it.y + 30} width="20" height="20" />
                <use href={id} x={it.x - 9} y={it.y + 48} width="18" height="18" />
              </g>
            </g>
          );
        }
        const l = leaf(it.len);
        return (
          <g class="sway" style={`transform-origin:${it.x}px ${it.y}px;animation-delay:${it.delay}s`} data-x={it.x}>
            <g class="push">
              <g transform={`translate(${it.x} ${it.y}) rotate(${it.tilt}) scale(${it.flip} 1)`}>
                <path d={l.body} class="shadow" transform="translate(2.5 3)" />
                <path d={l.body} fill={`url(#leaf-${it.tone})`} class="blade" />
                <path d={l.veins} class="veins" />
                <path d={l.rib} class="rib" />
                <path d={l.shine} class="shine" />
                <path d="M0 1 q-3 -5 1 -9 q4 -2 5 2" class="fold" />
              </g>
            </g>
          </g>
        );
      })
    }
  </svg>
</div>
