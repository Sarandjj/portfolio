---
// Maavilai thoranam: mango leaves tied on a rope across the top, with marigold balls between, as hung over
// doors for festivals and good occasions. Each leaf sways a little on its own.
const W = 1400;
const items = Array.from({ length: Math.floor(W / 30) }, (_, i) => {
  const x = 15 + i * 30;
  const y = 8 + 16 * Math.sin((Math.PI * x) / W);
  return { x, y, flower: i % 4 === 2, len: 50 + ((i * 7) % 3) * 6, tilt: ((i % 5) - 2) * 3, delay: -((i * 0.37) % 3).toFixed(2) };
});
---
<div class="thoranam" aria-hidden="true">
  <svg viewBox={`0 0 ${W} 100`} preserveAspectRatio="xMidYMin slice">
    <defs>
      <linearGradient id="mango-leaf" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#2e7d32"></stop>
        <stop offset="0.5" stop-color="#4caf50"></stop>
        <stop offset="1" stop-color="#2e7d32"></stop>
      </linearGradient>
    </defs>
    <path d={`M0 8 Q${W / 2} 40 ${W} 8`} class="rope" />
    {
      items.map((it) =>
        it.flower ? (
          <g class="sway" style={`transform-origin:${it.x}px ${it.y}px;animation-delay:${it.delay}s`}>
            <path d={`M${it.x} ${it.y} V${it.y + 18}`} class="string" />
            <circle cx={it.x} cy={it.y + 26} r="9" class="marigold" />
            <circle cx={it.x} cy={it.y + 26} r="5.5" class="marigold-in" />
            <circle cx={it.x} cy={it.y + 44} r="7" class="marigold" />
            <circle cx={it.x} cy={it.y + 44} r="4" class="marigold-in" />
          </g>
        ) : (
          <g class="sway" style={`transform-origin:${it.x}px ${it.y}px;animation-delay:${it.delay}s`}>
            <g transform={`translate(${it.x} ${it.y}) rotate(${it.tilt})`}>
              <path d={`M0 0 C10 ${it.len * 0.25} 10 ${it.len * 0.7} 0 ${it.len} C-10 ${it.len * 0.7} -10 ${it.len * 0.25} 0 0Z`} fill="url(#mango-leaf)" />
              <path d={`M0 2 V${it.len - 4}`} class="rib" />
            </g>
          </g>
        ),
      )
    }
  </svg>
</div>
