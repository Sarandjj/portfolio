---
// Mayil, the peacock mascot, drawn in code. A full fan of shaded feathers, a slender neck and crest.
// Eyes follow the cursor, the tail opens now and then and shivers when you hover or tap,
// and it sleeps at night (src/scripts/mayil.ts). Use one Mayil per page: the gradient ids are fixed.
import '../styles/mayil.css';

interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
// back row: long feathers; front row: shorter ones between them
const BACK = Array.from({ length: 13 }, (_, i) => -78 + i * 13);
const FRONT = Array.from({ length: 12 }, (_, i) => -71.5 + i * 13);
---

<svg class:list={['mayil', cls]} viewBox="0 0 160 150" role="img" aria-label="Mayil the peacock, the site mascot">
  <defs>
    <linearGradient id="my-vane" x1="0" y1="1" x2="0" y2="0">
      <stop offset="0" stop-color="#0f5132"></stop>
      <stop offset="0.6" stop-color="#2e8b57"></stop>
      <stop offset="1" stop-color="#7fb069"></stop>
    </linearGradient>
    <radialGradient id="my-eye-gold" cx="0.5" cy="0.55" r="0.5">
      <stop offset="0.7" stop-color="#e2b33c"></stop>
      <stop offset="1" stop-color="#9c6b1c"></stop>
    </radialGradient>
    <radialGradient id="my-eye-teal" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#4dd0c4"></stop>
      <stop offset="1" stop-color="#0f8f86"></stop>
    </radialGradient>
    <radialGradient id="my-eye-heart" cx="0.45" cy="0.4" r="0.6">
      <stop offset="0" stop-color="#3f51b5"></stop>
      <stop offset="1" stop-color="#0d1557"></stop>
    </radialGradient>
    <linearGradient id="my-body" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#2f80ed"></stop>
      <stop offset="0.55" stop-color="#1557b0"></stop>
      <stop offset="1" stop-color="#0b3570"></stop>
    </linearGradient>
    <linearGradient id="my-sheen" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#26c6da" stop-opacity="0"></stop>
      <stop offset="0.5" stop-color="#26c6da" stop-opacity="0.55"></stop>
      <stop offset="1" stop-color="#26c6da" stop-opacity="0"></stop>
    </linearGradient>
    <linearGradient id="my-wing" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#b08a5a"></stop>
      <stop offset="1" stop-color="#6d4c2f"></stop>
    </linearGradient>
    <g id="my-feather">
      <path d="M0 0 L0 -86" stroke="#c8b273" stroke-width="0.8"></path>
      <path d="M0 -14 C-8 -38 -11 -70 0 -100 C11 -70 8 -38 0 -14Z" fill="url(#my-vane)"></path>
      <path d="M0 -20 C-6 -40 -8 -66 -1 -92 M0 -20 C6 -40 8 -66 1 -92" stroke="rgba(190,230,170,.35)" stroke-width="0.6" fill="none"></path>
      <ellipse cx="0" cy="-86" rx="9" ry="11.5" fill="url(#my-eye-gold)"></ellipse>
      <ellipse class="ring" cx="0" cy="-85.5" rx="6.6" ry="8.6" fill="url(#my-eye-teal)"></ellipse>
      <ellipse cx="0" cy="-84.5" rx="3.6" ry="5.2" fill="url(#my-eye-heart)"></ellipse>
      <ellipse cx="-1.2" cy="-87" rx="1" ry="1.6" fill="#fff" opacity=".5"></ellipse>
    </g>
  </defs>

  <g class="tail">
    <g class="row back">
      {BACK.map((a, i) => <use href="#my-feather" transform={`translate(80 122) rotate(${a})`} />)}
    </g>
    <g class="row front">
      {FRONT.map((a, i) => <use href="#my-feather" transform={`translate(80 122) rotate(${a}) scale(0.72)`} />)}
    </g>
  </g>

  <g class="bob">
    <!-- folded wings with a little barring -->
    <path d="M64 96 C56 106 58 122 70 128 C70 116 70 104 70 96Z" fill="url(#my-wing)"></path>
    <path d="M96 96 C104 106 102 122 90 128 C90 116 90 104 90 96Z" fill="url(#my-wing)" class="wing"></path>
    <path d="M61 106 h8 M60 113 h9 M62 120 h8 M91 106 h8 M91 113 h9 M92 120 h8" stroke="#f1e3c8" stroke-width="1" opacity=".55"></path>
    <!-- body, neck and head in one shape, with an iridescent sheen -->
    <path d="M80 128 C67 128 63 114 64 100 C65 88 72 80 74 70 C75 62 72 52 73 45 C74 36 86 36 87 45 C88 52 85 62 86 70 C88 80 95 88 96 100 C97 114 93 128 80 128Z" fill="url(#my-body)"></path>
    <path d="M73 52 C75 66 74 78 70 90" stroke="url(#my-sheen)" stroke-width="6" fill="none" stroke-linecap="round" class="sheen"></path>
    <!-- crest -->
    <g class="crest" stroke="#1557b0" stroke-width="0.9" stroke-linecap="round">
      <path d="M80 37 L72 22 M80 37 L76 20 M80 37 L80 19 M80 37 L84 20 M80 37 L88 22"></path>
      {[[72, 22], [76, 20], [80, 19], [84, 20], [88, 22]].map(([x, y]) => <ellipse cx={x} cy={y} rx="1.9" ry="2.4" fill="#1aa59a" stroke="#0d1557" stroke-width="0.5" />)}
    </g>
    <!-- face: white eye stripes, eyes, beak -->
    <path d="M73.5 42 Q76.5 39.5 79 42 Q76.5 44.5 73.5 42Z M81 42 Q83.5 39.5 86.5 42 Q83.5 44.5 81 42Z" fill="#fff" class="open"></path>
    <circle class="pupil" data-eye="l" data-cx="76.3" data-cy="42" cx="76.3" cy="42" r="1.6" fill="#141412"></circle>
    <circle class="pupil" data-eye="r" data-cx="83.7" data-cy="42" cx="83.7" cy="42" r="1.6" fill="#141412"></circle>
    <path class="closed" d="M73.5 42.5 Q76.3 44.5 79 42.5 M81 42.5 Q83.7 44.5 86.5 42.5" stroke="#fff" stroke-width="1.2" fill="none" stroke-linecap="round"></path>
    <path d="M78.2 45.5 Q80 44.6 81.8 45.5 L80 50Z" fill="#d9c08a"></path>
  </g>
  <path d="M75 127 v13 M71 140 h7 M85 127 v13 M82 140 h7" stroke="#8d8d84" stroke-width="2.4" stroke-linecap="round"></path>
  <g class="zz" font-family="Geist Mono Variable, monospace" font-weight="600" fill="#605c53">
    <text x="104" y="30" font-size="12">z</text>
    <text x="112" y="20" font-size="9">z</text>
  </g>
</svg>
