---
// How data moves through one app: the same "lane" as the Services page, with packets travelling
// along the links (showcase.css). Left to right on wide screens, top to bottom on phones.
// Real text, so it is readable by search engines and screen readers, unlike an image.
interface Props {
  title: string;
  steps: { label: string; note: string }[];
}
const { title, steps } = Astro.props;
const cols = steps.map(() => '1fr').join(' 48px ');
const style = `--cols:${cols}`;
---

<figure class="arch">
  <figcaption class="kick reveal">{title}</figcaption>
  <div class="lane reveal" style="--lc:var(--c1)">
    <ol class="nodes" style={style}>
      {
        steps.map((s, i) => (
          <>
            {i > 0 && <li class="wlink" style={`--k:${i}`} aria-hidden="true"><i class="pk"></i><i class="pk back"></i></li>}
            <li class="wnode" style="--t1:var(--c1);--t2:var(--c2)">
              <span class="ic-tile sm num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <b>{s.label}</b>
              <span>{s.note}</span>
            </li>
          </>
        ))
      }
    </ol>
  </div>
</figure>
