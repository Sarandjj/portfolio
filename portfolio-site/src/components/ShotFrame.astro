---
// Stand-in for a real screenshot. Every one is clearly marked until real images exist.
interface Props { c1: string; c2: string; label?: string }
const { c1, c2, label = 'placeholder: add screenshot' } = Astro.props;
---

<div class="shot" style={`--c1:${c1};--c2:${c2}`}>
  <div class="shot-screen">
    <i></i><i></i><i></i>
    <span class="note-draft">{label}</span>
  </div>
</div>
