---
import { NAV, NAV_TA, SITE } from '../data/site';
import { SERVICES } from '../data/services';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap">
    <span>© {year} {SITE.name}</span>
    <nav aria-label="Footer">
      {NAV.map((l) => <a href={l.href} data-ta={NAV_TA[l.href]}>{l.label}</a>)}
      <a href={SITE.github} rel="noopener">GitHub</a>
      <a href={SITE.linkedin} rel="noopener">LinkedIn</a>
      <a href="/recruiter" data-ta="பணியமர்த்துவோர் பார்வை">Recruiter view</a>
      <a href="/privacy" data-ta="தனியுரிமை">Privacy</a>
      <button type="button" class="linklike" data-consent-open data-ta="குக்கீ அமைப்புகள்">Cookie settings</button>
    </nav>
    <nav class="footer-services" aria-label="Services">
      {SERVICES.map((s) => <a href={`/services/${s.slug}`} data-ta={s.ta.name}>{s.name}</a>)}
      <a href="/flutter-developer-tamil-nadu" data-ta="தமிழ்நாட்டில் Flutter டெவலப்பர்">Flutter developer in Tamil Nadu</a>
    </nav>
  </div>
</footer>
