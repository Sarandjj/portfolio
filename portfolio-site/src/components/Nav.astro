---
import { NAV, SITE } from '../data/site';
// Tamil labels for the language switch
const NAV_TA: Record<string, string> = { '/projects': 'படைப்புகள்', '/services': 'சேவைகள்', '/blog': 'வலைப்பதிவு', '/about': 'என்னைப் பற்றி', '/contact': 'தொடர்பு' };
---

<header class="nav" id="nav">
  <div class="wrap">
    <a class="mark" href="/" aria-label={`${SITE.name}, home`}><i></i>{SITE.name}</a>
    <nav class="navlinks" aria-label="Main">
      {NAV.map((l) => <a href={l.href} data-ta={NAV_TA[l.href]}>{l.label}</a>)}
    </nav>
    <div class="navr">
      <button class="kbd" id="openK" type="button" aria-label="⌘K: open command menu">⌘K</button>
      <button class="langsw" id="langSw" type="button" aria-pressed="false" title="English / தமிழ்"><span>EN</span><span lang="ta">த</span><span class="sr-only"> (switch between English and Tamil)</span></button>
      <button class="round" id="theme" type="button" aria-label="Toggle dark mode">◐</button>
      <a class="btn solid sm" href="/#contact" data-track="hire_click" data-track-item="nav" data-ta="அணுகுங்கள்">Hire me</a>
    </div>
  </div>
  <div class="progress" aria-hidden="true"><i id="progress"></i></div>
</header>
