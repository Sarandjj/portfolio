---
// Kovilpatti in one line: windmills on the horizon, the Kalugumalai rock, a temple gopuram, palmyra palms,
// the town, a match factory chimney, and a stack of kadalai mittai.
---
<figure class="skyline reveal" aria-label="Line drawing of Kovilpatti: windmills, the Kalugumalai rock, a temple tower, palmyra palms, the town, a match factory and kadalai mittai">
  <svg viewBox="0 0 1100 150" preserveAspectRatio="xMidYMax meet" aria-hidden="true">
    <g class="sk">
      <!-- windmills (the Kayathar wind farms nearby) -->
      <g class="mill"><path d="M40 140 L44 62 L48 140" /><g class="blades" style="transform-origin:44px 60px"><path d="M44 60 L44 30 M44 60 L70 75 M44 60 L18 75" /></g></g>
      <g class="mill"><path d="M100 140 L103 78 L106 140" /><g class="blades" style="transform-origin:103px 76px;animation-delay:-1.3s"><path d="M103 76 L103 54 M103 76 L122 87 M103 76 L84 87" /></g></g>
      <!-- Kalugumalai rock dome -->
      <path d="M150 140 Q170 92 230 86 Q290 92 310 140" />
      <path d="M214 98 h12 v8 h-12 z" />
      <!-- temple gopuram -->
      <path d="M360 140 V112 H440 V140 M368 112 L374 92 H426 L432 112 M378 92 L383 74 H417 L422 92 M387 74 L391 58 H409 L413 74 M394 58 Q400 44 406 58 M400 46 V38 M390 140 V124 Q400 116 410 124 V140" class="gopuram" />
      <!-- palmyra palms -->
      <path d="M480 140 Q482 100 478 68 M478 68 q-22 -6 -34 6 M478 68 q-20 -16 -30 -10 M478 68 q2 -20 -6 -26 M478 68 q14 -18 28 -14 M478 68 q22 -4 30 10" />
      <path d="M528 140 Q526 108 532 82 M532 82 q-20 -4 -30 8 M532 82 q-14 -16 -26 -10 M532 82 q4 -18 -2 -24 M532 82 q14 -14 26 -8 M532 82 q18 2 24 14" />
      <!-- town -->
      <path d="M580 140 V112 L600 100 L620 112 V140 M630 140 V118 H670 V140 M680 140 V106 L698 96 L716 106 V140" />
      <!-- match factory with chimney -->
      <path d="M760 140 V108 L780 98 V108 L800 98 V108 L820 98 V140 Z M832 140 V60 H844 V140" />
      <path d="M838 56 q-6 -8 2 -14 q8 -6 2 -14" class="smoke" />
      <!-- matchbox -->
      <path d="M880 140 V118 H930 V140 Z M880 124 H930 M896 118 V140" />
      <!-- kadalai mittai stack -->
      <path d="M970 140 H1050 V128 H970 Z M976 128 H1044 V116 H976 Z M982 116 H1038 V104 H982 Z" class="mittai-line" />
      <path d="M0 140 H1100" />
    </g>
  </svg>
  <figcaption><span lang="ta">கோவில்பட்டி</span> · Made with care in Kovilpatti, Tamil Nadu</figcaption>
</figure>
