---
// App icon glyphs drawn in code, one per app (by project slug) plus the phone's system apps.
// Only the white glyph is drawn here; the coloured tile behind it comes from the parent.
interface Props {
  name: string;
  class?: string;
}
const { name, class: cls = '' } = Astro.props;
---

<svg class:list={['appicon', cls]} viewBox="0 0 64 64" aria-hidden="true">
