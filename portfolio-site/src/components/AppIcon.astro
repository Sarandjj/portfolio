---
// App icon glyphs drawn in code, one per app (by project slug) plus the phone's system apps.
// Only the white glyph is drawn here; the coloured tile behind it comes from the parent.
interface Props {
  name: string;
  class?: string;
}
const { name, class: cls = '' } = Astro.props;
---

<svg class:list={['appicon', cls]} viewBox="0 0 64 64" aria-hidden="true">
  {name === 'sports-booking-app' && (
    <g>
      <circle cx="32" cy="32" r="17" class="s" />
      <path d="M19 21 Q31 32 19 43 M45 21 Q33 32 45 43" class="s" />
    </g>
  )}
  {name === 'weather-monitoring-app' && (
    <g>
      <circle cx="40" cy="22" r="6" class="s" />
      <path d="M40 10 v3 M50 13 l-2 2 M53 22 h-3" class="s" />
      <path d="M19 41 h24 a7.5 7.5 0 0 0 -1.5 -14.8 a10.5 10.5 0 0 0 -20 2.8 a6 6 0 0 0 -2.5 12Z" class="f" />
      <path d="M14 52 l9 -4 l8 3 l9 -6 l10 2" class="s thin" />
    </g>
  )}
  {name === 'finwise' && (
    <g>
      <path d="M21 17 H43 M21 25 H43 M25 17 Q40 17 40 25 Q40 33 25 33 L40 48" class="s" />
      <path d="M44 44 l6 -6 m0 0 h-5 m5 0 v5" class="s thin" />
    </g>
  )}
  {name === 'nirai' && (
    <g>
      <rect x="15" y="15" width="34" height="34" rx="10" class="s" />
      <path d="M24 33 l6 6 l11 -13" class="s" />
    </g>
  )}
  {name === 'nallhub' && (
    <g>
      <path d="M8 27 L32 16 L56 27 L32 38 Z" class="f" />
      <path d="M19 32 V41 Q32 49 45 41 V32" class="s" />
      <path d="M54 28 V40" class="s thin" />
      <circle cx="54" cy="42" r="2.5" class="f" />
    </g>
  )}
  {name === 'coin18' && (
    <g>
      <path d="M20 16 V48 M32 12 V42 M44 20 V52" class="s thin" />
      <rect x="15.5" y="24" width="9" height="16" rx="2" class="f" />
      <rect x="27.5" y="18" width="9" height="14" rx="2" class="o" />
      <rect x="39.5" y="28" width="9" height="16" rx="2" class="f" />
    </g>
  )}
  {name === 'clean-scanner' && (
    <g>
      <path d="M16 25 V16 H25 M39 16 H48 V25 M48 39 V48 H39 M25 48 H16 V39" class="s" />
      <path d="M24 24 H40 M24 30 H36 M24 36 H38" class="s thin" />
      <path d="M12 42 H52" class="s scan" />
    </g>
  )}
  {name === 'about' && (
    <g>
      <circle cx="32" cy="24" r="8" class="s" />
      <path d="M17 49 Q18 36 32 36 Q46 36 47 49" class="s" />
    </g>
  )}
  {name === 'stack' && (
    <g>
      <path d="M32 14 L52 24 L32 34 L12 24 Z" class="f" />
      <path d="M12 32 L32 42 L52 32 M12 40 L32 50 L52 40" class="s" />
    </g>
  )}
  {name === 'writing' && (
    <g>
      <path d="M40 14 L50 24 L28 46 L16 48 L18 36 Z" class="s" />
      <path d="M35 19 L45 29" class="s thin" />
    </g>
  )}
  {name === 'mail' && (
    <g>
      <rect x="12" y="18" width="40" height="28" rx="6" class="s" />
      <path d="M14 21 L32 34 L50 21" class="s" />
    </g>
  )}
  {name === 'linkedin' && (
    <g>
      <rect x="15" y="27" width="7" height="22" rx="2" class="f" />
      <circle cx="18.5" cy="18.5" r="4.2" class="f" />
      <path d="M30 49 V27 M30 36 Q30 27 39 27 Q47 27 47 36 V49" class="s" style="stroke-width:7;stroke-linecap:butt" />
    </g>
  )}
  {name === 'github' && (
    <g>
      <circle cx="22" cy="18" r="5" class="s" />
      <circle cx="22" cy="46" r="5" class="s" />
      <circle cx="42" cy="26" r="5" class="s" />
      <path d="M22 23 V41 M42 31 Q42 38 26 43" class="s" />
    </g>
  )}
</svg>
