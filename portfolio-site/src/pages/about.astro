---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { getProjects } from '../lib/projects';
import { SITE } from '../data/site';

const projects = await getProjects();
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    url: `${SITE.url}/about`,
    mainEntity: { '@id': `${SITE.url}/#person` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'About', item: `${SITE.url}/about` },
    ],
  },
];
---

<Base
  title="About | Sarankumar G"
  description="Sarankumar G is a mobile and full-stack developer from Tamil Nadu, India. Flutter, React, Supabase, Firebase, Node.js and FastAPI, with a focus on fast, private, offline-first apps."
  jsonLd={jsonLd}
>
  <div class="page">
    <div class="wrap">
      <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'About' }]} />

      <header class="about-hero" style="margin-top:22px">
        <div class="photo">
          <div>
            <span class="note-draft">placeholder: add your photo</span>
          </div>
        </div>
        <div>
          <h1 class="page-title" style="margin-top:0">Hi, I'm <em>Saran.</em></h1>
          <p class="page-lede">
            I'm a mobile and full-stack developer from Tamil Nadu, India. I build Flutter and React apps and the Supabase, Firebase,
            Node.js and FastAPI systems behind them, with a focus on apps that are fast, private and work offline.
          </p>
          <p class="page-lede" style="margin-top:14px">
            <span class="note-draft">placeholder: add your story in your own words, for example how you started, what you enjoy, and what kind of work you want</span>
          </p>
          <div class="page-cta">
            <a class="btn solid" href="/contact">Work with me</a>
            <a class="btn ghost" href="/Sarankumar-G-CV.pdf" download>Download CV</a>
          </div>
        </div>
      </header>

      <section>
        <h2 class="sec-h">In <em>short.</em></h2>
        <dl class="facts">
          <div><dt>Who</dt><dd>Sarankumar G, a mobile and full-stack developer at Neural Schema IT, open to freelance projects.</dd></div>
          <div><dt>Where</dt><dd>Tamil Nadu, India (IST). Works remotely with clients anywhere.</dd></div>
          <div><dt>Builds</dt><dd>Android, iOS and web apps in Flutter and React, with the backends behind them.</dd></div>
          <div><dt>Stack</dt><dd>Flutter, Dart, Riverpod, React, Drift, Supabase, Firebase, Node.js, FastAPI.</dd></div>
          <div><dt>Known for</dt><dd>Offline-first, private apps, and security rules in the database.</dd></div>
          <div><dt>Contact</dt><dd><a href="/contact">Contact form</a> or {SITE.email}</dd></div>
        </dl>
      </section>

      <section>
        <h2 class="sec-h">How I like to <em>build.</em></h2>
        <p class="lede"><span class="note-draft">draft, based on the rules in my own projects. Confirm or edit.</span></p>
        <div class="values">
          <div class="box"><h3>Local first</h3><p>Data is written to the device first, so apps are instant and work without a connection. Sync comes on top.</p></div>
          <div class="box"><h3>Private by default</h3><p>Clean Scanner never uses the network for its core features. Nirai syncs to your own Google Drive. No data goes where it doesn't need to.</p></div>
          <div class="box"><h3>Tested on real phones</h3><p>Layouts are checked at small sizes, large text, dark mode and in Tamil, and scrolling is measured on a real phone.</p></div>
        </div>
      </section>

      <section>
        <h2 class="sec-h">What I <em>work with.</em></h2>
        <div class="skills">
          <div><h3>Mobile</h3><p>Flutter, Dart, Riverpod, GetX, camera, ML Kit and biometrics plugins</p></div>
          <div><h3>Data &amp; backend</h3><p>Drift (SQLite), Supabase (Postgres, Auth, Edge Functions, RLS), Firebase, Node.js with Express, FastAPI (Python)</p></div>
          <div><h3>Web</h3><p>React, Flutter Web, Astro (this site), Firebase Hosting</p></div>
          <div><h3>Shipping</h3><p>Google Play Console, Render, Git</p></div>
        </div>
      </section>

      <section>
        <h2 class="sec-h">Building <em>now.</em></h2>
        <ul class="timeline" style="margin-top:28px">
          {
            projects.map((p) => (
              <li>
                <span class="when">In progress</span>
                <h3><a href={`/projects/${p.id}`}>{p.data.name}</a></h3>
                <p>{p.data.summary}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2 class="sec-h">Experience &amp; <em>education.</em></h2>
        <ul class="timeline" style="margin-top:28px">
          <li>
            <span class="when">Feb 2026 – Present</span>
            <h3>Full Stack Developer, Neural Schema IT</h3>
            <p>Full stack mobile and web apps with Flutter, React/Next.js and FastAPI, REST APIs, PostgreSQL design and AWS services, across several client projects.</p>
          </li>
          <li>
            <span class="when">Nov 2023 – Jan 2026</span>
            <h3>Mobile App Developer, Digisailor</h3>
            <p>Built and maintained production Flutter apps, Node.js and TypeScript backends on PostgreSQL, and shipped apps to the Google Play Store and Apple App Store.</p>
          </li>
          <li>
            <span class="when">Education</span>
            <h3>B.Sc Computer Science</h3>
            <p>Sri S. Ramasamy Naidu Memorial College, Sattur</p>
          </li>
        </ul>
      </section>

      <div class="cta-band">
        <h2>Let's talk about your <em>project.</em></h2>
        <p>Tell me what you need and I'll get back to you.</p>
        <a class="btn solid" href="/contact">Get in touch</a>
      </div>
    </div>
  </div>
</Base>
