---
import Base from '../layouts/Base.astro';
import Mayil from '../components/Mayil.astro';
---

<Base title="Page not found | Sarankumar G" description="This page does not exist." noindex>
  <section class="nf">
    <div class="wrap">
      <div class="nf-mayil"><Mayil /></div>
      <p class="label" style="justify-content:center">404 · page not found</p>
      <h1 class="nf-h">Mayil looked everywhere.</h1>
      <p class="lede" style="margin:0 auto">That page doesn't exist, or it has moved. Let's get you back on track.</p>
      <div class="cta" style="justify-content:center">
        <a class="btn solid" href="/">Back to home</a>
        <a class="btn ghost" href="/projects">See my work</a>
      </div>
    </div>
  </section>

  <style>
    .nf { text-align: center; padding: 80px 0 120px; }
    .nf-mayil { width: 160px; margin: 0 auto 8px; }
    .nf-h { font-size: clamp(38px, 7vw, 80px); line-height: 1; letter-spacing: -0.04em; font-weight: 600; margin: 12px 0 18px; }
  </style>
  <script>
    import '../scripts/mayil';
  </script>
</Base>
