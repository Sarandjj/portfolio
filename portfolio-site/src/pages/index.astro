---
import Base from '../layouts/Base.astro';
import Phone from '../components/Phone.astro';
import AppIcon from '../components/AppIcon.astro';
import { postLook } from '../data/post-look';
import TempleBorder from '../components/TempleBorder.astro';
import Skyline from '../components/Skyline.astro';
import Thoranam from '../components/festival/Thoranam.astro';
import DoorstepKolam from '../components/festival/DoorstepKolam.astro';
import Malligai from '../components/festival/Malligai.astro';
import '../styles/home.css';
import { SITE, STATUS_LABEL, PERSON, PERSON_REF } from '../data/site';
import { getPosts, readingMinutes } from '../lib/posts';
import { getProjects } from '../lib/projects';
import { shots } from '../lib/shots';
const PROJECTS = (await getProjects()).map((p) => ({ slug: p.id, ...p.data }));
const LIVE = PROJECTS.filter((p) => p.links.length > 0);
const OWN = PROJECTS.filter((p) => p.links.length === 0);
const FEATURED = OWN.find((p) => p.screens.length > 0);
const FEATURED_SHOTS = FEATURED ? await shots(FEATURED.screens) : [];
const REST = OWN.filter((p) => p !== FEATURED);
const DEMOS = PROJECTS.filter((p) => p.demo);
const FILTERS = [['all', 'All'], ['live', 'On the stores'], ['mobile', 'Mobile'], ['web', 'Web'], ['backend', 'Backend']];
const tagsOf = (p: (typeof PROJECTS)[number]) => [...p.tags, ...(p.links.length ? ['live'] : [])].join(' ');

const codeSample = `<span class="k">class</span> <span class="f">YourApp</span> <span class="k">extends</span> <span class="f">StatelessWidget</span> {
  <span class="d">// idea → store, one codebase</span>
  <span class="k">@override</span>
  <span class="f">Widget</span> <span class="c">build</span>(<span class="f">BuildContext</span> context) {
    <span class="k">return</span> <span class="f">MaterialApp</span>(
      title: <span class="s">'Your app'</span>,
      home: <span class="k">const</span> <span class="f">Delightful</span>(),
    );
  }
}`;

const posts = await getPosts();
const jsonLd = [
  {
    '@context': 'https://schema.org',
    ...PERSON,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    url: SITE.url,
    name: SITE.name,
    inLanguage: 'en',
    publisher: PERSON_REF,
  },
];
---

<Base jsonLd={jsonLd}>
  <section class="hero" id="top" style="padding-bottom:40px">
    <Thoranam />
    <div class="pulli-field" aria-hidden="true"></div>
    <div class="aurora" aria-hidden="true"><i class="a1"></i><i class="a2"></i><i class="a3"></i></div>
    <div class="wrap">
      <div>
        <div class="pill-status">
          <span class="live"><b data-ta="தேர்ந்தெடுத்த ஃப்ரீலான்ஸ் பணிகளுக்குத் தயார்">Open to selected freelance work</b></span>
          <span class="sep" aria-hidden="true"></span>
          <span>Kovilpatti · <span id="istSmall">IST --:--</span></span>
        </div>
        <p class="kicker" data-ta="வணக்கம், நான் சரண்குமார்."><span lang="ta">வணக்கம்</span>, I'm Sarankumar.</p>
        <h1 data-ta="&lt;span class=&quot;line&quot;&gt;&lt;span&gt;உங்கள் &lt;em&gt;கைப்பேசிக்கான&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;line&quot;&gt;&lt;span&gt;&lt;em&gt;செயலிகளையும்,&lt;/em&gt; அவற்றின்&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;line&quot;&gt;&lt;span&gt;பின்னணி அமைப்புகளையும்&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;line&quot;&gt;&lt;span&gt;உருவாக்குகிறேன்.&lt;/span&gt;&lt;/span&gt;">
          <span class="line"><span>I build <em>apps for</em></span></span>
          <span class="line"><span><span class="ul"><em>your pocket</em><svg class="scribble" viewBox="0 0 300 22" preserveAspectRatio="none" aria-hidden="true"><path d="M4 15 C50 5 96 19 150 10 S250 4 296 13" /></svg></span> and the</span></span>
          <span class="line"><span>systems behind them.</span></span>
        </h1>
        <p class="intro" data-ta="Flutter, React கொண்டு வேகமான, தனியுரிமை காக்கும், இணையம் இல்லாதபோதும் இயங்கும் செயலிகளையும் அவற்றின் backend-ஐயும், யோசனை முதல் ஸ்டோர் வெளியீடு வரை உருவாக்கும் &lt;b&gt;மொபைல் &amp;amp; ஃபுல்-ஸ்டாக் டெவலப்பர்&lt;/b&gt;.">
          A <b>mobile &amp; full-stack developer</b> making fast, private, offline-first apps in Flutter and React, with the backend behind them, from idea to store release.
        </p>
        <div class="doors">
          <a class="door" href="/recruiter" data-track="recruiter_view">
            <small data-ta="பணியமர்த்துகிறீர்களா?">Hiring or recruiting?</small>
            <b data-ta="பணியமர்த்துவோர் பார்வை">Recruiter view</b>
            <span data-ta="அனுபவம், திறன்கள், CV ஒரே பக்கத்தில் · 1 நிமிடம்">Experience, skills and CV on one page · 1 min</span>
            <i aria-hidden="true">→</i>
          </a>
          <a class="door hot beam" href="#contact" data-track="door_client">
            <span class="beam-line" aria-hidden="true"></span>
            <small data-ta="செயலி யோசனை இருக்கிறதா?">Have an app in mind?</small>
            <b data-ta="சேர்ந்து உருவாக்குவோம்">Let's build it</b>
            <span data-ta="வேலை அளவு, காலம், செலவு: எழுத்தில்">Scope, timeline and budget, in writing</span>
            <i aria-hidden="true">→</i>
          </a>
        </div>
      </div>
      <div class="phone-col">
        <Phone />
      </div>
    </div>
    <div class="wrap">
      <ul class="proofbar" aria-label="In numbers">
        <li><b data-count="2">2</b> <span data-ta="இரண்டு ஸ்டோர்களிலும் உள்ள வாடிக்கையாளர் செயலிகள்">client apps live on both stores</span></li>
        <li><b data-count="447">447</b> <span data-ta="NallHub-இல் தானியங்கி சோதனைகள்">tests in NallHub</span></li>
        <li><b data-count="0">0</b> <span data-ta="Nirai-க்குப் பின்னால் சர்வர்கள்">servers behind Nirai</span></li>
        <li><b data-count="100">100</b> <span data-ta="Lighthouse அணுகல்தன்மை மதிப்பெண்">Lighthouse accessibility score</span></li>
      </ul>
    </div>
    <a class="scrollcue" href="#work" aria-label="Scroll to my work"><span></span></a>
  </section>

  <section id="work" class="has-aurora" style="padding-top:60px">
    <div class="aurora soft" aria-hidden="true"><i class="a1"></i><i class="a3"></i></div>
    <div class="wrap">
      <div class="label reveal">01 / Selected work<span class="ta-label" lang="ta">௧ · படைப்புகள்</span></div>
      <h2 class="reveal" data-ta="நான் &lt;em&gt;வெளியிட்டவையும் உருவாக்கியவையும்.&lt;/em&gt;">Things I've <em>shipped and built.</em></h2>
      <p class="lede reveal" data-ta="Play Store, App Store இரண்டிலும் உள்ள இரண்டு வாடிக்கையாளர் செயலிகள், என் சொந்த ஐந்து செயலிகள். ஒவ்வொன்றுக்கும் ஒரு சிறு case study: பிரச்சினை, உருவாக்கம், கடினமான பகுதி, இப்போதைய நிலை.">
        Two client apps live on the Play Store and App Store, and five of my own. Each one has a short case study: the problem, the build, the hard part, and where it stands.
      </p>

      <div class="filters reveal" role="group" aria-label="Filter projects">
        {FILTERS.map(([v, l], i) => (
          <button type="button" data-f={v} aria-pressed={i === 0 ? 'true' : 'false'}>
            {l} <span class="cnt">{v === 'all' ? PROJECTS.length : PROJECTS.filter((p) => tagsOf(p).split(' ').includes(v)).length}</span>
          </button>
        ))}
        <span class="seen-count" id="seenCount" hidden></span>
      </div>

      <h3 class="group reveal" data-group data-ta="ஸ்டோர்களில் வெளியான &lt;span&gt;வாடிக்கையாளர் திட்டங்கள்&lt;/span&gt;">Live on the stores <span>client projects</span></h3>
      <div class="cards" data-cards>
        {
          LIVE.map((p) => (
            <a class="pcard reveal" href={`/projects/${p.slug}`} style={`--c1:${p.c1};--c2:${p.c2}`} data-tags={tagsOf(p)} data-slug={p.slug}>
              <span class="corners" aria-hidden="true"></span>
              <div class="pc-top">
                <span class="icon" style={`view-transition-name:ic-${p.slug}`} aria-hidden="true"><AppIcon name={p.slug} /></span>
                <span class="wm" aria-hidden="true"><AppIcon name={p.slug} /></span>
                <span class="fig mono">FIG. {String(p.order).padStart(2, '0')}<span class="seen" hidden> · ✓ read</span></span>
                <span class="badge" data-status={p.status}>{STATUS_LABEL[p.status]}</span>
              </div>
              <h3>{p.name}</h3>
              <p class="kind">{p.kind} · {p.platforms}</p>
              <p class="sum">{p.summary}</p>
              <div class="pc-foot">
                <span class="stores">{p.links.map((l) => <i>{l.label}</i>)}</span>
                <span class="more">Case study <b aria-hidden="true">→</b></span>
              </div>
            </a>
          ))
        }
      </div>

      <h3 class="group reveal" data-group data-ta="என் சொந்த செயலிகள் &lt;span&gt;முழுமையாக நானே உருவாக்கியவை&lt;/span&gt;">My own apps <span>built end to end</span></h3>
      <div class="cards" data-cards>
        {FEATURED && (
          <article class="pcard feat beam reveal" style={`--c1:${FEATURED.c1};--c2:${FEATURED.c2}`} data-tags={tagsOf(FEATURED)} data-slug={FEATURED.slug}>
            <span class="beam-line" aria-hidden="true"></span>
            <span class="corners" aria-hidden="true"></span>
            <div class="feat-text">
              <div class="pc-top">
                <span class="icon" style={`view-transition-name:ic-${FEATURED.slug}`} aria-hidden="true"><AppIcon name={FEATURED.slug} /></span>
                <span class="fig mono">FIG. {String(FEATURED.order).padStart(2, '0')} · featured<span class="seen" hidden> · ✓ read</span></span>
                <span class="badge" data-status={FEATURED.status}>{STATUS_LABEL[FEATURED.status]}</span>
              </div>
              <h3>{FEATURED.name}</h3>
              <p class="kind">{FEATURED.kind} · {FEATURED.platforms}</p>
              <p class="sum">{FEATURED.summary}</p>
              <ul class="feat-nums">
                {FEATURED.numbers.map((n) => <li><b>{n.value}</b>{n.label}</li>)}
              </ul>
              <div class="feat-cta">
                <a class="btn solid sm" href={`/projects/${FEATURED.slug}`}>Read the case study</a>
                {FEATURED.demo && <a class="btn ghost sm" href={FEATURED.demo.url} target="_blank" rel="noopener" data-track="demo_open" data-track-item={FEATURED.slug}>Try the live demo ↗</a>}
              </div>
            </div>
            <div class="feat-shots" aria-hidden="true">
              {/* two phones, each slowly cross-fading between two real screens */}
              {[FEATURED_SHOTS.slice(0, 2), FEATURED_SHOTS.slice(2, 4)].map((pair, i) => (
                <div class={`ph ${i ? 'b' : 'a'}`}>
                  {pair.map((sh) => <img src={sh.src} srcset={sh.srcset} sizes="(max-width: 640px) 130px, 210px" alt="" width={sh.width} height={sh.height} loading="lazy" decoding="async" />)}
                </div>
              ))}
            </div>
          </article>
        )}
        {
          REST.map((p) => (
            <a class="pcard reveal" href={`/projects/${p.slug}`} style={`--c1:${p.c1};--c2:${p.c2}`} data-tags={tagsOf(p)} data-slug={p.slug}>
              <span class="corners" aria-hidden="true"></span>
              <div class="pc-top">
                <span class="icon" style={`view-transition-name:ic-${p.slug}`} aria-hidden="true"><AppIcon name={p.slug} /></span>
                <span class="wm" aria-hidden="true"><AppIcon name={p.slug} /></span>
                <span class="fig mono">FIG. {String(p.order).padStart(2, '0')}<span class="seen" hidden> · ✓ read</span></span>
                <span class="badge" data-status={p.status}>{STATUS_LABEL[p.status]}</span>
              </div>
              <h3>{p.name}</h3>
              <p class="kind">{p.kind} · {p.platforms}</p>
              <p class="sum">{p.summary}</p>
              <div class="pc-foot">
                {p.proof && <span class="proof"><b>{p.proof.value}</b> {p.proof.label}</span>}
                <span class="more">{p.demo ? 'Case study + demo' : 'Case study'} <b aria-hidden="true">→</b></span>
              </div>
            </a>
          ))
        }
      </div>

      <div class="tryit reveal">
        <div>
          <h3 data-ta="உங்கள் உலாவியிலேயே முயற்சி செய்யுங்கள்.">Try them in your browser.</h3>
          <p data-ta={`என் ${DEMOS.length} செயலிகள் போலித் தரவுடன் இணையத்தில் நேரலையாக இயங்குகின்றன. பதிவு தேவையில்லை, எதுவும் சேமிக்கப்படாது.`}>{DEMOS.length} of my apps run live on the web with made-up data. No sign-up, nothing is saved.</p>
        </div>
        <div class="tryit-btns">
          {DEMOS.map((p) => (
            <a class="demo-btn" href={p.demo!.url} target="_blank" rel="noopener" data-track="demo_open" data-track-item={p.slug} style={`--c1:${p.c1};--c2:${p.c2}`}>
              <span aria-hidden="true"><AppIcon name={p.slug} /></span>{p.name} <small>↗</small>
            </a>
          ))}
        </div>
      </div>

      <p class="reveal" style="margin-top:28px"><a class="btn ghost sm" href="/projects">All projects →</a></p>
    </div>
  </section>

  <section id="services">
    <div class="wrap">
      <div class="label reveal">02 / What I do<span class="ta-label" lang="ta">௨ · சேவைகள்</span></div>
      <h2 class="reveal" data-ta="Flutter மட்டுமல்ல. &lt;em&gt;முழு தயாரிப்பும்,&lt;/em&gt; முன்பக்கம் முதல் பின்பக்கம் வரை.">Not just Flutter. <em>The whole product,</em> front to back.</h2>
      <p class="lede reveal" data-ta="செயலி, தரவு அடுக்கு, backend, வெளியீடு: அனைத்தையும் ஒரே டெவலப்பராக நானே கையாள்கிறேன்.">The app, the data layer, the backend and the release, handled by one developer.</p>

      <div class="bento">
        <div class="tile t-code reveal">
          <span class="tag">Mobile · Flutter</span>
          <h3>Apps that feel native on iOS, Android and the web</h3>
          <p>One codebase, careful UI, smooth animation, and offline-first by default.</p>
<div class="code" tabindex="0" role="region" aria-label="Flutter code sample" set:html={codeSample} />
        </div>

        <div class="tile t-term reveal">
          <span class="tag">Backend · Cloud</span>
          <h3>Supabase, Firebase, Node.js &amp; FastAPI</h3>
          <div class="term" id="term" aria-hidden="true"></div>
        </div>

        <div class="tile reveal">
          <span class="tag">Right now in Tamil Nadu</span>
          <svg class="dayarc" viewBox="0 0 120 44" aria-hidden="true">
            <path d="M8 40 A52 36 0 0 1 112 40" class="track" />
            <path d="M8 40 A52 36 0 0 1 112 40" class="done" pathLength="100" />
            <circle r="5" class="orb" cx="8" cy="40" />
          </svg>
          <div class="clock" id="clock">--:--</div>
          <p id="clockNote">Awake right now</p>
        </div>

        <div class="tile reveal">
          <span class="tag">Web · Speed</span>
          <div class="scores" role="img" aria-label="Lighthouse scores measured on this site: performance 98, accessibility 100, best practices 100">
            {
              [['98', 'Speed'], ['100', 'Access'], ['100', 'Practice']].map(([v, l]) => (
                <div class="score-wrap">
                  <div class="score">
                    <svg viewBox="0 0 52 52">
                      <circle cx="26" cy="26" r="22" stroke="#d6f0df" stroke-width="5" fill="none"></circle>
                      <circle class="arc" cx="26" cy="26" r="22" stroke="#1a9d5b" stroke-width="5" fill="none" stroke-linecap="round"></circle>
                    </svg>
                    <b>{v}</b>
                  </div>
                  <small>{l}</small>
                </div>
              ))
            }
          </div>
          <p>Lighthouse, on a simulated phone.</p>
        </div>

        <div class="tile t-stack reveal">
          <span class="tag">Toolbox</span>
          <div class="groups">
            {[
              ['Mobile', ['Flutter', 'Dart', 'Riverpod', 'ML Kit', 'Camera', 'Biometrics'], '#13b9fd'],
              ['Data & backend', ['Drift (SQLite)', 'Supabase', 'Firebase', 'Node.js', 'Express', 'FastAPI'], '#2bb673'],
              ['Web', ['React', 'Flutter Web', 'Astro', 'Firebase Hosting'], '#ff8a3d'],
              ['Shipping', ['Google Play Console', 'App Store', 'Render', 'Git'], '#a855f7'],
            ].map(([g, items, c]) => (
              <div style={`--g:${c}`}>
                <b>{g}</b>
                <ul class="chips">{(items as string[]).map((t) => <li>{t}</li>)}</ul>
              </div>
            ))}
          </div>
        </div>

        <a class="tile t-cta reveal" href="#contact">
          <span class="arrow" aria-hidden="true">→</span>
          <span class="cta-art" aria-hidden="true"><AppIcon name="ship" /></span>
          <div><h3>Have an app in mind?</h3><p>Let's talk scope, timeline and budget.</p></div>
        </a>
      </div>
    </div>
  </section>

  <section id="hello" class="hello-sec">
    <div class="wrap hs">
      <div class="bio reveal">
        <div class="label">03 / About me<span class="ta-label" lang="ta">௩ · என்னைப் பற்றி</span></div>
        <div class="biotog" role="group" aria-label="How much to read">
          <button type="button" data-len="short" aria-pressed="true" data-ta="சுருக்கம்">Short</button>
          <button type="button" data-len="long" aria-pressed="false" data-ta="விரிவாக">Long</button>
        </div>
        <div data-bio="short">
          <p class="bio-big" data-ta="தமிழ்நாட்டைச் சேர்ந்த மென்பொருள் டெவலப்பர் நான். யோசனைகளை முதல் திரையிலிருந்து database வரை &lt;em&gt;உண்மையான, பயன்படும் தயாரிப்புகளாக&lt;/em&gt; மாற்றுவது எனக்குப் பிடிக்கும்.">I'm a software developer from Tamil Nadu who enjoys turning ideas into <em>real, usable products,</em> from the first screen to the database.</p>
        </div>
        <div data-bio="long" hidden>
          <p class="bio-big">I'm a software developer from Tamil Nadu who enjoys turning ideas into <em>real, usable products.</em></p>
          <p>My journey started with a B.Sc. in Computer Science and grew through hands-on experience building mobile applications, web applications and backend systems. Flutter is my primary focus, but I also work with React, Node.js and modern backend technologies.</p>
          <p>Working on production projects taught me that building an app is about more than writing code. It's about understanding users, making good technical decisions, testing carefully, and delivering something reliable.</p>
          <p>Today I'm building and launching my own products, such as a personal finance manager and a school management platform. <a class="inline" href="/about">Read my full story →</a></p>
        </div>
      </div>
      <aside class="side reveal">
        <div class="now">
          <span class="mono" data-ta="இப்போது">Now</span>
          <p data-ta="FinWise, Nirai, NallHub உருவாக்கி வருகிறேன்; தேர்ந்தெடுத்த ஃப்ரீலான்ஸ் பணிகளுக்கும் தயார்.">Building FinWise, Nirai and NallHub, and open to selected freelance work.</p>
        </div>
        <div class="pearl mittai">
          <svg viewBox="0 0 64 48" width="64" height="48" aria-hidden="true">
