---
import Base from '../layouts/Base.astro';
import Phone from '../components/Phone.astro';
import '../styles/home.css';
import { SITE, STATUS_LABEL } from '../data/site';
import { getPosts, readingMinutes } from '../lib/posts';
import { getProjects } from '../lib/projects';
const PROJECTS = (await getProjects()).map((p) => ({ slug: p.id, ...p.data }));
const LIVE = PROJECTS.filter((p) => p.links.length > 0);
const OWN = PROJECTS.filter((p) => p.links.length === 0);
const FEATURED = OWN.find((p) => p.screens.length > 0);
const REST = OWN.filter((p) => p !== FEATURED);
const DEMOS = PROJECTS.filter((p) => p.demo);

const codeSample = `<span class="k">class</span> <span class="f">YourApp</span> <span class="k">extends</span> <span class="f">StatelessWidget</span> {
  <span class="d">// idea → store, one codebase</span>
  <span class="k">@override</span>
  <span class="f">Widget</span> <span class="c">build</span>(<span class="f">BuildContext</span> context) {
    <span class="k">return</span> <span class="f">MaterialApp</span>(
      title: <span class="s">'Your app'</span>,
      home: <span class="k">const</span> <span class="f">Delightful</span>(),
    );
  }
}`;

const posts = await getPosts();
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${SITE.url}/#person`,
    name: SITE.name,
    url: SITE.url,
    jobTitle: 'Mobile and full-stack developer',
    image: `${SITE.url}/saran.jpg`,
    email: SITE.email,
    address: { '@type': 'PostalAddress', addressRegion: 'Tamil Nadu', addressCountry: 'IN' },
    worksFor: { '@type': 'Organization', name: 'Neural Schema IT' },
    alumniOf: { '@type': 'CollegeOrUniversity', name: 'Sri S. Ramasamy Naidu Memorial College, Sattur' },
    sameAs: [SITE.github, SITE.linkedin],
    knowsAbout: ['Flutter', 'Dart', 'React', 'Firebase', 'Supabase', 'Node.js', 'FastAPI', 'Python', 'Offline-first apps', 'Mobile app development'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    url: SITE.url,
    name: SITE.name,
    inLanguage: 'en',
    publisher: { '@id': `${SITE.url}/#person` },
  },
];
---

<Base jsonLd={jsonLd}>
  <section class="hero" id="top" style="padding-bottom:40px">
    <div class="wrap">
      <div>
        <div class="hello">
          <img src="/saran-sm.jpg" alt="Sarankumar G" width="44" height="44" />
          <span>Hi, I'm <b>Sarankumar</b>. Full Stack Developer at Neural Schema IT.</span>
        </div>
        <div class="status">
          <span class="live"><b>Open to selected freelance work</b></span>
          <span>Thoothukudi, Tamil Nadu</span>
          <span id="istSmall">IST --:--</span>
        </div>
        <h1>
          <span class="line"><span>I build <em>apps for</em></span></span>
          <span class="line"><span><em>your pocket</em> and the</span></span>
          <span class="line"><span>systems behind them.</span></span>
        </h1>
        <p class="intro">
          I'm Sarankumar, a <b>mobile &amp; full-stack developer</b>. Flutter for iOS, Android and web, React for the web, with Supabase, Firebase,
          Node.js and FastAPI underneath. Fast, private, offline-first apps, from idea to release.
        </p>
        <div class="cta">
          <a class="btn solid" href="#work">See my work ↓</a>
          <a class="btn ghost" href="/recruiter" data-track="recruiter_view">Recruiter view <small class="cta-time">1 min</small></a>
          <span class="hint" aria-hidden="true">psst, the phone works →</span>
        </div>
      </div>
      <Phone />
    </div>
    <div class="wrap">
      <ul class="proofbar" aria-label="In numbers">
        <li><b>2</b> client apps live on both stores</li>
        <li><b>447</b> tests in NallHub</li>
        <li><b>0</b> servers behind Nirai</li>
        <li><b>100</b> Lighthouse accessibility score</li>
      </ul>
    </div>
  </section>

  <section id="services">
    <div class="wrap">
      <div class="label reveal">01 / What I do</div>
      <h2 class="reveal">Not just Flutter. <em>The whole product,</em> front to back.</h2>
      <p class="lede reveal">The app, the data layer, the backend and the release, handled by one developer.</p>

      <div class="bento">
        <div class="tile t-code reveal">
          <span class="tag">Mobile · Flutter</span>
          <h3>Apps that feel native on iOS, Android and the web</h3>
          <p>One codebase, careful UI, smooth animation, and offline-first by default.</p>
<div class="code" tabindex="0" role="region" aria-label="Flutter code sample" set:html={codeSample} />
        </div>

        <div class="tile t-term reveal">
          <span class="tag">Backend · Cloud</span>
          <h3>Supabase, Firebase, Node.js &amp; FastAPI</h3>
          <div class="term" id="term" aria-hidden="true"></div>
        </div>

        <div class="tile reveal">
          <span class="tag">Right now in Tamil Nadu</span>
          <div class="clock" id="clock">--:--</div>
          <p id="clockNote">Awake right now</p>
        </div>

        <div class="tile reveal">
          <span class="tag">Web · Speed</span>
          <div class="scores" role="img" aria-label="Lighthouse scores measured on this site: performance 99, accessibility 100, best practices 100">
            {
              [['99', 'Speed'], ['100', 'Access'], ['100', 'Practice']].map(([v, l]) => (
                <div class="score-wrap">
                  <div class="score">
                    <svg viewBox="0 0 52 52">
                      <circle cx="26" cy="26" r="22" stroke="#d6f0df" stroke-width="5" fill="none"></circle>
                      <circle class="arc" cx="26" cy="26" r="22" stroke="#1a9d5b" stroke-width="5" fill="none" stroke-linecap="round"></circle>
                    </svg>
                    <b>{v}</b>
                  </div>
                  <small>{l}</small>
                </div>
              ))
            }
          </div>
          <p>Measured with Lighthouse on this site, on a simulated phone, at the last check.</p>
        </div>

        <div class="tile t-stack reveal">
          <span class="tag">Toolbox</span>
          <div class="groups">
            <div><b>Mobile</b>Flutter, Dart, Riverpod, camera, ML Kit and biometrics plugins</div>
            <div><b>Data &amp; backend</b>Drift (SQLite), Supabase, Firebase, Node.js with Express, FastAPI (Python)</div>
            <div><b>Web</b>React, Flutter Web, Astro (this site), Firebase Hosting</div>
            <div><b>Shipping</b>Google Play Console, Render, Git</div>
          </div>
        </div>

        <a class="tile t-cta reveal" href="#contact">
          <span class="arrow" aria-hidden="true">→</span>
          <div><h3>Have an app in mind?</h3><p>Let's talk scope, timeline and budget.</p></div>
        </a>
      </div>
    </div>
  </section>

  <section id="work" style="padding-top:20px">
    <div class="wrap">
      <div class="label reveal">02 / Selected work</div>
      <h2 class="reveal">Things I've <em>shipped and built.</em></h2>
      <p class="lede reveal">
        Two client apps live on the Play Store and App Store, and five of my own. Each one has a short case study: the problem, the build, the hard part, and where it stands.
      </p>

      <h3 class="group reveal">Live on the stores <span>client projects</span></h3>
      <div class="cards">
        {
          LIVE.map((p) => (
            <a class="pcard reveal" href={`/projects/${p.slug}`} style={`--c1:${p.c1};--c2:${p.c2}`}>
              <div class="pc-top">
                <span class="icon" aria-hidden="true">{p.emoji}</span>
                <span class="badge" data-status={p.status}>{STATUS_LABEL[p.status]}</span>
              </div>
              <h3>{p.name}</h3>
              <p class="kind">{p.kind} · {p.platforms}</p>
              <p class="sum">{p.summary}</p>
              <div class="pc-foot">
                <span class="stores">{p.links.map((l) => <i>{l.label}</i>)}</span>
                <span class="more">Case study <b aria-hidden="true">→</b></span>
              </div>
            </a>
          ))
        }
      </div>

      <h3 class="group reveal">My own apps <span>built end to end</span></h3>
      <div class="cards">
        {FEATURED && (
          <article class="pcard feat reveal" style={`--c1:${FEATURED.c1};--c2:${FEATURED.c2}`}>
            <div class="feat-text">
              <div class="pc-top">
                <span class="icon" aria-hidden="true">{FEATURED.emoji}</span>
                <span class="badge" data-status={FEATURED.status}>{STATUS_LABEL[FEATURED.status]}</span>
              </div>
              <h3>{FEATURED.name}</h3>
              <p class="kind">{FEATURED.kind} · {FEATURED.platforms}</p>
              <p class="sum">{FEATURED.summary}</p>
              <ul class="feat-nums">
                {FEATURED.numbers.map((n) => <li><b>{n.value}</b>{n.label}</li>)}
              </ul>
              <div class="feat-cta">
                <a class="btn solid sm" href={`/projects/${FEATURED.slug}`}>Read the case study</a>
                {FEATURED.demo && <a class="btn ghost sm" href={FEATURED.demo.url} target="_blank" rel="noopener" data-track="demo_open" data-track-item={FEATURED.slug}>Try the live demo ↗</a>}
              </div>
            </div>
            <div class="feat-shots" aria-hidden="true">
              {FEATURED.screens.slice(0, 2).map((sh, i) => <img src={sh.src} alt="" width="540" height="979" loading="lazy" decoding="async" class={i ? 'b' : 'a'} />)}
            </div>
          </article>
        )}
        {
          REST.map((p) => (
            <a class="pcard reveal" href={`/projects/${p.slug}`} style={`--c1:${p.c1};--c2:${p.c2}`}>
              <div class="pc-top">
                <span class="icon" aria-hidden="true">{p.emoji}</span>
                <span class="badge" data-status={p.status}>{STATUS_LABEL[p.status]}</span>
              </div>
              <h3>{p.name}</h3>
              <p class="kind">{p.kind} · {p.platforms}</p>
              <p class="sum">{p.summary}</p>
              <div class="pc-foot">
                {p.proof && <span class="proof"><b>{p.proof.value}</b> {p.proof.label}</span>}
                <span class="more">{p.demo ? 'Case study + demo' : 'Case study'} <b aria-hidden="true">→</b></span>
              </div>
            </a>
          ))
        }
      </div>

      <div class="tryit reveal">
        <div>
          <h3>Try them in your browser.</h3>
          <p>{DEMOS.length} of my apps run live on the web with made-up data. No sign-up, nothing is saved.</p>
        </div>
        <div class="tryit-btns">
          {DEMOS.map((p) => (
            <a class="demo-btn" href={p.demo!.url} target="_blank" rel="noopener" data-track="demo_open" data-track-item={p.slug} style={`--c1:${p.c1};--c2:${p.c2}`}>
              <span aria-hidden="true">{p.emoji}</span>{p.name} <small>↗</small>
            </a>
          ))}
        </div>
      </div>

      <p class="reveal" style="margin-top:28px"><a class="btn ghost sm" href="/projects">All projects →</a></p>
    </div>
  </section>

  <section id="experience" style="padding-top:20px">
    <div class="wrap">
      <div class="label reveal">03 / Experience</div>
      <h2 class="reveal">Where I've <em>worked.</em></h2>
      <ol class="xp">
        <li class="reveal">
          <span class="when">Feb 2026 – Present</span>
          <div><h3>Full Stack Developer <span>Neural Schema IT</span></h3><p>Mobile and web apps with Flutter, React/Next.js and FastAPI, REST APIs, PostgreSQL and AWS, across several client projects.</p></div>
        </li>
        <li class="reveal">
          <span class="when">Nov 2023 – Jan 2026</span>
          <div><h3>Mobile App Developer <span>Digisailor</span></h3><p>Production Flutter apps, Node.js and TypeScript backends on PostgreSQL, and releases to Google Play and the App Store.</p></div>
        </li>
        <li class="reveal">
          <span class="when">Education</span>
          <div><h3>B.Sc Computer Science <span>Sri S. Ramasamy Naidu Memorial College, Sattur</span></h3></div>
        </li>
      </ol>
      <p class="reveal" style="margin-top:24px;display:flex;gap:10px;flex-wrap:wrap">
        <a class="btn ghost sm" href="/Sarankumar-G-CV.pdf" data-track="cv_download">Download CV (PDF)</a>
        <a class="btn ghost sm" href="/about">More about me →</a>
      </p>
    </div>
  </section>

  <section id="process" style="background:var(--paper2)">
    <div class="wrap">
      <div class="label reveal">04 / How I work</div>
      <h2 class="reveal">Simple process, <em>no surprises.</em></h2>
      <p class="lede reveal">From the first call to the store release, you always know what happens next.</p>
      <div class="steps">
        <div class="step reveal"><span class="mono">01</span><h3>Discover</h3><p>A short call to understand the goal, the users and the budget. You get the scope in writing.</p></div>
        <div class="step reveal"><span class="mono">02</span><h3>Design</h3><p>Key screens and flows agreed before any code is written.</p></div>
        <div class="step reveal"><span class="mono">03</span><h3>Build</h3><p>Regular builds you can install and try, so feedback comes early.</p></div>
        <div class="step reveal"><span class="mono">04</span><h3>Ship &amp; support</h3><p>Store release, analytics, and fixes after launch.</p></div>
      </div>
    </div>
  </section>

  <section id="writing">
    <div class="wrap">
      <div class="label reveal">05 / Writing</div>
      <h2 class="reveal">Notes from <em>building.</em></h2>
      <p class="lede reveal">Short engineering notes from the apps above: the problem, the decision, and the trade-off.</p>
      <div class="pgrid">
        {
          posts.slice(0, 3).map((p) => (
            <a class="pcell reveal" href={`/blog/${p.id}`}>
              <span class="mono">{p.data.tags[0]} · {readingMinutes(p.body)} min read</span>
              <h3>{p.data.title}</h3>
              <p>{p.data.description}</p>
              <span class="more">Read <b aria-hidden="true">→</b></span>
            </a>
          ))
        }
      </div>
      <p class="reveal" style="margin-top:24px"><a class="btn ghost sm" href="/blog">All posts →</a></p>
    </div>
  </section>

  <section class="contact" id="contact">
    <div class="wrap">
      <div class="big reveal">Got an idea?<em>Let's build it.</em></div>
      <p class="lede reveal" style="margin:20px auto 0">Tell me what you need and I'll get back to you.</p>
      <button class="mail reveal" type="button" data-copy-email>{SITE.email} <small data-copy-label>click to copy</small></button>
      <div class="socials reveal">
        <a class="btn solid sm" href="/contact" data-track="contact_open">Send a message</a>
        <a class="btn ghost sm" href={`mailto:${SITE.email}`}>Email</a>
        <a class="btn ghost sm" href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a class="btn ghost sm" href={SITE.github} target="_blank" rel="noopener">GitHub</a>
      </div>
    </div>
  </section>

  <script>
    import '../scripts/kili';
    import '../scripts/home';
  </script>
</Base>
