---
import AppIcon from '../../components/AppIcon.astro';
import TempleBorder from '../../components/TempleBorder.astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import ArchDiagram from '../../components/ArchDiagram.astro';
import ShotFrame from '../../components/ShotFrame.astro';
import DemoPhone from '../../components/DemoPhone.astro';
import { getProjects } from '../../lib/projects';
import { SITE, PERSON_REF } from '../../data/site';
import { shots } from '../../lib/shots';

export async function getStaticPaths() {
  const all = await getProjects();
  return all.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: all[i - 1], next: all[i + 1] },
  }));
}

const { entry, prev, next } = Astro.props;
const p = entry.data;
const { Content, headings } = await render(entry);
const screenShots = await shots(p.screens);
const toc = headings.filter((h) => h.depth === 2);
// Show the phone frames only when there are real screenshots. Placeholders look unfinished.
const url = `${SITE.url}/projects/${entry.id}`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: p.name,
    description: p.summary,
    url,
    applicationCategory: 'MobileApplication',
    operatingSystem: p.platforms,
    ...(p.links[0] ? { installUrl: p.links[0].url } : {}),
    author: PERSON_REF,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Projects', item: `${SITE.url}/projects` },
      { '@type': 'ListItem', position: 3, name: p.name, item: url },
    ],
  },
];
---

<Base title={`${p.name}: ${p.kind} | ${SITE.name}`} description={p.description ?? p.summary} image={`/og/projects/${entry.id}.png`} jsonLd={jsonLd}>
  <div class="page" style={`--c1:${p.c1};--c2:${p.c2}`}>
    <div class="wrap">
      <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Projects', href: '/projects' }, { label: p.name }]} />

      <div class="cs-cover" aria-hidden="true"><span class="ring"></span><span class="ring r2"></span></div>
      <header class="cs-hero">
        <div>
          <span class="cs-icon" style={`view-transition-name:ic-${entry.id}`} aria-hidden="true"><AppIcon name={entry.id} /></span>
          <p class="label" style="margin:22px 0 0">{p.kind}</p>
          <h1 class:list={['page-title', { long: p.name.length > 14 }]}>{p.name}</h1>
          <p class="page-lede">{p.summary}</p>
          {p.role && <p class="page-lede" style="margin-top:10px;font-size:15px"><b>Role:</b> {p.role}</p>}
          <div class="meta-row">
            <StatusBadge status={p.status} />
            <span class="mono" style="font-size:13px;color:var(--muted)">{p.platforms}</span>
          </div>
          <div class="chips" style="margin-top:16px">{p.stack.map((s) => <span class="chip">{s}</span>)}</div>
          <div class="page-cta">
            {
              p.links.length > 0
                ? p.links.map((l, i) => <a class={`btn ${i === 0 ? 'solid' : 'ghost'}`} href={l.url} target="_blank" rel="noopener">{l.label} ↗</a>)
                : <a class="btn solid" href={`/contact?topic=${entry.id}`}>Get notified when it ships</a>
            }
            <a class="btn ghost" href="/projects">All projects</a>
          </div>
        </div>
        {
          (
            screenShots.length > 0 ? (
              <div class="shots shots-real" aria-label="Screenshots">
                {screenShots.slice(0, 3).map((sc) => <img class="shot-img" src={sc.src} srcset={sc.srcset} sizes="(max-width: 960px) 120px, 150px" alt={sc.alt} width={sc.width} height={sc.height} loading="eager" />)}
              </div>
            ) : (
              <div class="shots" aria-label="Screen previews">
                <ShotFrame c1={p.c1} c2={p.c2} slug={entry.id} name={p.name} v={0} />
                <ShotFrame c1={p.c1} c2={p.c2} slug={entry.id} name={p.name} v={1} />
                <ShotFrame c1={p.c1} c2={p.c2} slug={entry.id} name={p.name} v={2} />
              </div>
            )
          )
        }
      </header>

      {
        p.numbers.length > 0 && (
          <ul class="cs-stats" aria-label="By the numbers">
            {p.numbers.map((n) => <li><b>{n.value}</b><span>{n.label}</span></li>)}
          </ul>
        )
      }

      {p.demo && <DemoPhone url={p.demo.url} name={p.name} slug={entry.id} c1={p.c1} c2={p.c2} note={p.demo.note} />}

      <section>
        <div class="cs-grid">
          <article class="prose"><Content /></article>
          <aside class="aside">
            {toc.length > 2 && (
              <nav class="toc" aria-label="On this page">
                <p class="mono">On this page</p>
                <ol>
                  {toc.map((h, i) => (
                    <li><a href={`#${h.slug}`}><span>{String(i + 1).padStart(2, '0')}</span>{h.text}</a></li>
                  ))}
                </ol>
                <span class="toc-bar" aria-hidden="true"><i></i></span>
              </nav>
            )}
            <div class="box">
              <h3>Works today</h3>
              <ul>{p.works.map((w) => <li>{w}</li>)}</ul>
            </div>
          </aside>
        </div>
      </section>

      {p.architecture && <section><ArchDiagram title={p.architecture.title} steps={p.architecture.steps} /></section>}

      <nav class="pager" aria-label="More projects">
        {prev ? <a href={`/projects/${prev.id}`}><span class="pg-icon" style={`background:linear-gradient(135deg,${prev.data.c1},${prev.data.c2})`} aria-hidden="true"><AppIcon name={prev.id} /></span><span><small>Previous</small><b>{prev.data.name}</b></span></a> : <span></span>}
        {next ? <a href={`/projects/${next.id}`} class="nx"><span><small>Next</small><b>{next.data.name}</b></span><span class="pg-icon" style={`background:linear-gradient(135deg,${next.data.c1},${next.data.c2})`} aria-hidden="true"><AppIcon name={next.id} /></span></a> : <span></span>}
      </nav>

      <TempleBorder />
      <div class="cta-band">
        <h2>Want something like this?</h2>
        <p>Tell me what you need and I'll get back to you.</p>
        <a class="btn solid" href="/contact">Start a project</a>
      </div>
    </div>
  </div>
  <script is:inline define:vars={{ slug: entry.id }}>
    try {
      const k = 'seen-projects';
      const seen = JSON.parse(localStorage.getItem(k) || '[]');
      if (!seen.includes(slug)) localStorage.setItem(k, JSON.stringify([...seen, slug]));
    } catch {}
  </script>
</Base>
