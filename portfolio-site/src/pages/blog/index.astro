---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getPosts, readingMinutes } from '../../lib/posts';
import { SITE } from '../../data/site';
import AppIcon from '../../components/AppIcon.astro';

import { postLook as look } from '../../data/post-look';

const posts = await getPosts();
const fmt = (d: Date) => d.toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'Notes from building',
    url: `${SITE.url}/blog`,
    author: { '@id': `${SITE.url}/#person` },
    blogPost: posts.map((p) => ({ '@type': 'BlogPosting', headline: p.data.title, url: `${SITE.url}/blog/${p.id}`, datePublished: p.data.date.toISOString() })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.url}/blog` },
    ],
  },
];
---

<Base
  title="Blog | Notes from building apps | Sarankumar G"
  description="Short engineering notes from building Flutter apps: offline sync with no backend, soft deletes in Drift, and choosing ML Kit over a hand-built scanner."
  image="/og/blog.png"
  jsonLd={jsonLd}
>
  <div class="page">
    <div class="wrap">
      <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Blog' }]} />
      <header>
        <p class="label" style="margin:22px 0 0">Writing</p>
        <h1 class="page-title" data-ta="உருவாக்கும்போது &lt;em&gt;எழுதிய குறிப்புகள்.&lt;/em&gt;">Notes from <em>building.</em></h1>
        <p class="page-lede">What I ran into while building my own apps, and what I did about it. One problem per post, with the decision and the trade-off.</p>
      </header>

      <ul class="blog-list">
        {
          posts.map((p) => (
            <li style={`--t1:${look(p.id).c1};--t2:${look(p.id).c2}`}>
              <a href={`/blog/${p.id}`}>
                <span class="bl-icon" aria-hidden="true"><AppIcon name={look(p.id).g} /></span>
                <span class="mono meta">{fmt(p.data.date)} · {readingMinutes(p.body)} min read · {p.data.tags.join(', ')}</span>
                <h2>{p.data.title}</h2>
                <p>{p.data.description}</p>
                <span class="bl-more">Read the note <b aria-hidden="true">→</b></span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Base>
