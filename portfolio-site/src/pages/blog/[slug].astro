---
import { render, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getPosts, readingMinutes } from '../../lib/posts';
import { SITE } from '../../data/site';

export async function getStaticPaths() {
  const all = await getPosts();
  return all.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, newer: all[i - 1], older: all[i + 1] },
  }));
}

const { entry, newer, older } = Astro.props;
const p = entry.data;
const { Content } = await render(entry);
const project = await getEntry('projects', p.project);
const url = `${SITE.url}/blog/${entry.id}`;
const fmt = (d: Date) => d.toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: p.title,
    description: p.description,
    datePublished: p.date.toISOString(),
    dateModified: p.date.toISOString(),
    mainEntityOfPage: url,
    url,
    image: `${SITE.url}/og/blog/${entry.id}.png`,
    keywords: p.tags.join(', '),
    author: { '@id': `${SITE.url}/#person` },
    publisher: { '@id': `${SITE.url}/#person` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.url}/blog` },
      { '@type': 'ListItem', position: 3, name: p.title, item: url },
    ],
  },
];
---

<Base title={`${p.title} | ${SITE.name}`} description={p.description} image={`/og/blog/${entry.id}.png`} jsonLd={jsonLd}>
  <div class="page">
    <div class="wrap">
      <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Blog', href: '/blog' }, { label: p.title }]} />
      <article class="post-page">
        <header>
          <p class="mono meta" style="margin:22px 0 0">
            <time datetime={p.date.toISOString()}>{fmt(p.date)}</time> · {readingMinutes(entry.body)} min read
            {project && <> · From <a href={`/projects/${project.id}`}>{project.data.name}</a></>}
          </p>
          <h1 class="page-title">{p.title}</h1>
          <p class="page-lede">{p.description}</p>
          {!p.reviewed && <p><span class="note-draft">draft: written from the project's own notes, not yet reviewed by Saran</span></p>}
        </header>
        <div class="prose"><Content /></div>
      </article>

      <nav class="pager" aria-label="More posts">
        {newer ? <a href={`/blog/${newer.id}`}><small>Newer</small><b>{newer.data.title}</b></a> : <span></span>}
        {older ? <a href={`/blog/${older.id}`}><small>Older</small><b>{older.data.title}</b></a> : <span></span>}
      </nav>

      <div class="cta-band">
        <h2>Building something similar?</h2>
        <p>Tell me what you need and I'll get back to you.</p>
        <a class="btn solid" href="/contact">Get in touch</a>
      </div>
    </div>
  </div>
</Base>
